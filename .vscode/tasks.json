{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (Chromium + Firefox)",
      "type": "shell",
      "command": "python3 scripts/build.py",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Package for stores",
      "type": "shell",
      "command": "python3 scripts/build.py --package",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
